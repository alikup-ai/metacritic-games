# --- Роль процесса: api | worker | all (по умолчанию all) ---
APP_ROLE=all

# ВНИМАНИЕ: это шаблон. Реальные значения хранятся только в .env (в .gitignore).
# Никакие реальные ключи, токены и пароли не должны попадать в репозиторий.

# --- База данных ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/metacritic

# --- Обработка (ADR-0002, ADR-0004) ---
PROCESSING_TIMEZONE=UTC
BATCH_SIZE=20
WORKER_CONCURRENCY=4
CLAIM_LEASE_MINUTES=10
MAX_ATTEMPTS=3
# Запасной критерий orphaned run (ADR-0010)
HEARTBEAT_TIMEOUT_MINUTES=15

# --- Планировщик и воркеры (Phase 1C) ---
# Выключен по умолчанию: включение начинает обращения к Metacritic
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_MINUTES=60
WORKER_LEASE_MINUTES=10
WORKER_HEARTBEAT_INTERVAL_SECONDS=180
MAX_PAGES_PER_RUN=25
MAX_EMPTY_PAGES=3

# --- Отзывы (Phase 1D) ---
# Критический endpoint игнорирует limit и всегда отдаёт 10
REVIEW_CRITIC_PAGE_SIZE=10
REVIEW_USER_PAGE_SIZE=50
REVIEW_MAX_PAGES=12
# 0 = без ограничения
REVIEW_MAX_CRITIC=0
REVIEW_MAX_USER=50

# --- Анализ отзывов LLM (ADR-0006, ADR-0013) ---
# Провайдер: OpenRouter (https://openrouter.ai/api/v1/chat/completions).
# Выключен по умолчанию: включение начинает тратить деньги.
# Ключ задаётся ТОЛЬКО через окружение и никогда не логируется.
LLM_ENABLED=false
# Формат OpenRouter: <организация>/<модель>. Модель заменяется без правки кода.
LLM_MODEL=anthropic/claude-haiku-4.5
LLM_API_KEY=<your-api-key>
LLM_MAX_REVIEWS=60
LLM_MAX_REVIEW_CHARS=1200
LLM_MAX_INPUT_TOKENS=20000
LLM_MAX_OUTPUT_TOKENS=6000
LLM_TIMEOUT_MS=60000
LLM_RETRY_COUNT=2
LLM_MIN_REVIEWS=3
LLM_PROMPT_VERSION=v1
LLM_SAMPLING_VERSION=v1

# --- HTTP к внешним источникам ---
METACRITIC_RATE_LIMIT_RPS=1
HTTP_TIMEOUT_MS=15000
# Только символы Latin-1: HTTP-заголовки не допускают кириллицу
METACRITIC_USER_AGENT=MetacriticGamesBot/0.1 (evaluation project; contact in repository)
# Догрузка общего Userscore — дополнительный запрос на игру (ADR-0011)
METACRITIC_FETCH_USERSCORE=false

# --- HTTP API (Phase 3A) ---
API_PORT=3001
API_HOST=0.0.0.0
API_DEFAULT_PAGE_SIZE=20
API_MAX_PAGE_SIZE=100
# Ограничение частоты защищённых операций
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=10

# --- Force Run (ADR-0007). Сгенерируйте случайное значение, не публикуйте ---
ADMIN_TOKEN=<generate-a-random-64-char-token>

# --- YouTube (ADR-0005). По умолчанию выключено ---
FEATURE_YOUTUBE_ENABLED=false
YOUTUBE_ENABLED=false
YOUTUBE_API_KEY=<your-youtube-api-key>
YOUTUBE_TIMEOUT_MS=10000
YOUTUBE_MAX_RESULTS=15
YOUTUBE_MIN_DURATION_SECONDS=240
YOUTUBE_MAX_DURATION_SECONDS=5400
YOUTUBE_MAX_TRANSCRIPT_CHARS=24000

# Внешний поставщик расшифровок (запасной, если субтитры YouTube недоступны).
# Без ключа используется только timedtext; система продолжает работать.
SUPADATA_API_KEY=<your-supadata-api-key>
SUPADATA_TIMEOUT_MS=30000
# Язык третьего приоритета после en и ru
TRANSCRIPT_FALLBACK_LANGUAGE=
